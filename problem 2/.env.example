# Campus Orbit Environment Configuration
# Copy this file to .env to configure custom settings.
# If no keys are provided, Campus Orbit automatically runs in DEMO MODE.

# Server Configuration
PORT=8000
HOST=0.0.0.0
DEBUG=True

# AI API Configuration (Optional - Demo Mode activates automatically if not provided)
# Supports Google Gemini API or OpenAI API
AI_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_MODEL=gemini-1.5-flash

# Database Configuration (Optional - default is fast in-memory SQLite store)
DATABASE_URL=sqlite:///./campus_orbit.db
