# Database Connection
# Default SQLite local database file
DATABASE_URL="file:./dev.db"

# Optional: Remote PostgreSQL / Neon database connection string
# DATABASE_URL="postgresql://user:password@ep-sample.aws.neon.tech/campusflow?sslmode=require"

# Optional AI Providers (System falls back to built-in deterministic planning engine if not provided)
OPENAI_API_KEY=""
GEMINI_API_KEY=""
AI_PROVIDER="deterministic" # Options: "deterministic" | "gemini" | "openai"

# Server Configuration
PORT=3000
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
